{
  // Deploy: node site/build.mjs && cd site/host && npx wrangler deploy
  // No `main`, because Cloudflare serves static assets directly when no script is bound.
  "name": "quickstart-icons",

  "compatibility_date": "2026-08-13",

  // custom_domain lets Cloudflare own the DNS record and the certificate for this one name.
  "routes": [
    { "pattern": "icons.evanpizzolato.com", "custom_domain": true }
  ],

  "assets": {
    // Build output, gitignored, so build before deploying.
    "directory": "../dist",
    // An unknown URL gets dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
